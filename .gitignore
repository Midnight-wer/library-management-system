# ============================================================
# 图书管理系统 .gitignore
# ============================================================

# ---------- 后端: 构建产物 ----------
后端服务/target/
*.class

# ---------- 后端: 运行时上传目录 ----------
# 默认全部忽略(用户运行时上传的文件不入库),
# 仅白名单保留随项目分发的种子资源: 15 张图书封面 + admin 默认头像
后端服务/uploads/**
!后端服务/uploads/covers/
!后端服务/uploads/covers/**
!后端服务/uploads/2026/
!后端服务/uploads/2026/09/
!后端服务/uploads/2026/09/09/
!后端服务/uploads/2026/09/09/82e8db49e3224e3a80c78d347c7dbe97.jpg

# ---------- 前端: 依赖与构建产物 ----------
前端界面/node_modules/
前端界面/dist/
前端界面/npm-debug.log*

# ---------- 日志文件 ----------
*.log
*.err
backend.log
frontend.log
nohup.out

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
.trae/
*.iml

# ---------- 操作系统文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
~$*

# ---------- 临时文件 ----------
*.tmp
*.bak
*.pid
