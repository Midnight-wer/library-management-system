@echo off
chcp 936 >nul
title 图书管理系统-一键停止
cd /d "%~dp0"

REM ============================================================
REM  图书管理系统 一键停止脚本 (Windows)
REM  停止后端(8080)与前端(5173/4173), 不影响 MySQL 服务
REM  注意: 本文件必须以 GBK/ANSI 编码保存, 勿转为 UTF-8
REM ============================================================

color 0E
echo ============================================================
echo   停止图书管理系统服务...
echo ============================================================
echo.

echo [1/2] 停止后端服务 (端口 8080)...
call :KILL_PORT 8080

echo.
echo [2/2] 停止前端服务 (端口 5173 / 4173)...
call :KILL_PORT 5173
call :KILL_PORT 4173

echo.
color 0A
echo ============================================================
echo   所有服务已停止
echo   (MySQL 数据库服务未受影响)
echo ============================================================
pause
exit /b 0

REM ==================== 子程序 ====================

REM 按端口杀掉 LISTENING 进程, %~1 = 端口号
:KILL_PORT
set "FOUND=0"
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%~1 " ^| findstr "LISTENING"') do (
    taskkill /F /PID %%a >nul 2>&1
    echo   [成功] 已停止进程 (PID: %%a, 端口: %~1)
    set "FOUND=1"
)
if "%FOUND%"=="0" echo   [提示] 端口 %~1 无服务运行
exit /b 0
